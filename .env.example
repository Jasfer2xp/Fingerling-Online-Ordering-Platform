# Environment Configuration for Fingerling Marketplace
# Copy this file to .env and update with your actual values

# Google OAuth Credentials
# Get these from: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Database Configuration
DB_HOST=localhost
DB_NAME=fingerling_marketplace
DB_USER=root
DB_PASS=

# Hosting-specific Database Configurations
INFINITYFREE_HOST=sql200.infinityfree.com
INFINITYFREE_DB_NAME=if0_39794261_fingerling_marketplace
INFINITYFREE_USERNAME=if0_39794261
INFINITYFREE_PASSWORD=your_infinityfree_password_here

HOSTINGER_HOST=localhost
HOSTINGER_DB_NAME=u123456789_fingerling
HOSTINGER_USERNAME=u123456789_username
HOSTINGER_PASSWORD=your_hostinger_password_here

LOCALHOST_HOST=localhost
LOCALHOST_DB_NAME=fingerling_marketplace
LOCALHOST_USERNAME=root
LOCALHOST_PASSWORD=

WEBHOST_HOST=databases.000webhost.com
WEBHOST_DB_NAME=id12345678_fingerling
WEBHOST_USERNAME=id12345678_username
WEBHOST_PASSWORD=your_000webhost_password_here

CPANEL_HOST=localhost
CPANEL_DB_NAME=username_fingerling
CPANEL_USERNAME=username_dbuser
CPANEL_PASSWORD=your_cpanel_password_here

# Payment Gateway Configuration
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_MODE=sandbox

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_ENCRYPTION=tls
FROM_EMAIL=your_email@gmail.com
FROM_NAME=Fingerling Online Ordering Platform

# Application Settings
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/capstone/
GMAIL_VERIFY_STRICT=true
SUPPORT_EMAIL=support@example.com

# Maps, payments, and messaging (leave blank when the feature is not used)
GOOGLE_MAPS_API_KEY=
XENDIT_API_KEY=
XENDIT_WEBHOOK_TOKEN=
SEMAPHORE_API_KEY=
ESIGIL_API_KEY=
