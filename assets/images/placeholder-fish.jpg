<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 64 64">
  <defs>
    <linearGradient id="g" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#3B82F6"/>
      <stop offset="100%" stop-color="#1D4ED8"/>
    </linearGradient>
    <filter id="shadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="1" stdDeviation="1" flood-color="#000" flood-opacity="0.25"/>
    </filter>
  </defs>

  <!-- Background circle for better visibility on light/dark tabs -->
  <circle cx="32" cy="32" r="30" fill="#ffffff" fill-opacity="0.9"/>

  <!-- Fish body -->
  <g filter="url(#shadow)">
    <ellipse cx="30" cy="32" rx="16" ry="10" fill="url(#g)"/>
    <!-- Tail -->
    <path d="M44 26 L58 20 L58 44 L44 38 Z" fill="url(#g)"/>
    <!-- Fin -->
    <path d="M24 28 C22 26, 20 25, 18 26 C20 28, 20 30, 18 32 C21 31, 23 30, 24 28 Z" fill="#60A5FA"/>
    <!-- Eye -->
    <circle cx="26" cy="30" r="2.6" fill="#fff"/>
    <circle cx="26.6" cy="30.2" r="1.4" fill="#111827"/>
    <!-- Mouth hint -->
    <path d="M20 33 C21 34, 22.5 34.2, 24 33.8" stroke="#93C5FD" stroke-width="1.6" fill="none" stroke-linecap="round"/>
    <!-- Gill line -->
    <path d="M28.5 32 a4 3 0 1 1 0.01 0" stroke="#1E40AF" stroke-opacity="0.2" stroke-width="1" fill="none"/>
  </g>
</svg>
