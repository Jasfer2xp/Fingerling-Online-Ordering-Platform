# Local environment credentials
.env
.env.*
!.env.example

# Editor and PHP runtime files
.vscode/
/logs/*.log
/sessions/*

# Local database exports and generated/debug artifacts
/backups/**/*.sql
*.backup
/check_*.php
/debug_*.php
/test_*.php

# User-provided data; retain directory guards required by the application
/uploads/**
!/uploads/**/
!/uploads/**/index.php
/customer/uploads/**
!/customer/uploads/**/
!/customer/uploads/**/index.php
