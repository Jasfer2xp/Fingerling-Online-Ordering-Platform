# Local environment credentials
.env
.env.*
!.env.example

# Editor and PHP runtime files
.vscode/
/runtime/logs/*.log
/runtime/sessions/*

# Local database exports and generated/debug artifacts
/runtime/backups/**/*.sql
*.backup
/check_*.php
/debug_*.php
/test_*.php

# User-provided data; retain directory guards required by the application
/apps/web/uploads/**
!/apps/web/uploads/**/
!/apps/web/uploads/**/index.php
/apps/web/customer/uploads/**
!/apps/web/customer/uploads/**/
!/apps/web/customer/uploads/**/index.php
